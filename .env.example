# Copy to .env and fill in values from REGOS.Online.

REGOS_INTEGRATION_TOKEN=

# Required only for catalog integrations that use OAuth.
# Leave empty when using a local integration token.
REGOS_CLIENT_ID=
REGOS_CLIENT_SECRET=

REGOS_AUTH_URL=https://auth.regos.uz
REGOS_API_BASE=https://integration.regos.uz/gateway/out
